{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cosvault",
  "version": "0.1.0",
  "identifier": "com.cosvault.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "TAURI_BUILD=1 bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cosvault",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "devCsp": null,
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "",
    "category": "Photography",
    "shortDescription": "Local-first cosplay photo & video organizer",
    "longDescription": "Cosvault is a local-first desktop application for organizing large cosplay photo & video collections. Hierarchy: Cosplayer → Character → Set → Media. Files stay on your device — never uploaded."
  }
}
